# ==============================
# SocioChat Backend Configuration  
# ==============================

# Flask
SECRET_KEY=your-secret-key-change-this
SQLALCHEMY_DATABASE_URI=sqlite:///sociochat.db
# For PostgreSQL: SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost:5432/sociochat

# SMTP (Gmail app password — quote value if it contains spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.sociovia@gmail.com
SMTP_PASS="your-gmail-app-password"
MAIL_FROM="Sociovia <noreply.sociovia@gmail.com>"

# App URLs
APP_BASE_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5173

# Admin
ADMIN_EMAILS=admin@sociochat.com

# JWT Auth
JWT_EXPIRY_HOURS=168

# ==============================
# WhatsApp / Meta Configuration
# ==============================

# Meta App Credentials (from developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# WhatsApp Webhook Verification Token (you define this)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# WhatsApp Encryption Key (for token encryption at rest)
WHATSAPP_ENCRYPTION_KEY=

# ==============================
# AI / LLM Configuration
# ==============================

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (optional, for template rewriting)
OPENAI_API_KEY=

# ==============================
# Google Services (optional)
# ==============================

# Google Service Account JSON (for Sheets integration in drip campaigns)
SERVICE_ACCOUNT_JSON=

# ==============================
# RAG / Qdrant Cloud (knowledge base — no local disk storage)
# ==============================
QUADRANT_ENDPOINT=
QUADRANT_KEY=
QUADRANT_CLUSTER_NAME=sociochat
RAG_COLLECTION_NAME=sociochat
EMBEDDING_MODEL=gemini-embedding-001

# ==============================
# Storage — DigitalOcean Spaces (optional)
# ==============================
# Bucket: sociovia @ blr1 — SocioChat files stored under sociochat/
SPACE_NAME=sociovia
SPACE_REGION=blr1
SPACE_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACE_CDN=https://sociovia.blr1.cdn.digitaloceanspaces.com
SPACE_PREFIX=sociochat
ACCESS_KEY=
DO_SPACES_SECRET_KEY=

# ==============================
# Scheduler / Queue / Billing (WhatsApp platform parity)
# ==============================

SCHEDULER_SECRET_TOKEN=default-insecure-token-please-change-me
REDIS_URL=redis://localhost:6379/0
WHATSAPP_USAGE_EVENTS_SECRET=
WHATSAPP_CAPABILITIES_UPSERT_SECRET=
WHATSAPP_DEPLOYMENT_ENV=development
SERVICE_MODE=api
