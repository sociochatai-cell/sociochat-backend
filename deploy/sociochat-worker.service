# ============================================================================
#  systemd unit for the SocioChat WhatsApp QUEUE WORKER (Option B topology)
#  Runs worker.py, which consumes the Redis job queue (drip/bulk/warmup/etc.)
#  enqueued by the API. Idles harmlessly if JOB_QUEUE_BACKEND != redis.
#
#  Put at:  /etc/systemd/system/sociochat-worker.service
#  Then:
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now sociochat-worker
#     journalctl -u sociochat-worker -f
#
#  REQUIRES (in the shared .env, same file the API uses):
#     JOB_QUEUE_BACKEND=redis
#     REDIS_URL=redis://127.0.0.1:6379/0   (or your managed Redis URL)
# ============================================================================
[Unit]
Description=SocioChat WhatsApp queue worker
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/sociochat/backend
EnvironmentFile=/var/www/sociochat/backend/.env
Environment=SERVICE_MODE=worker

# Same venv as the API. worker.py boots the app context, then (with
# JOB_QUEUE_BACKEND=redis) runs the queue-consumer loop. It also serves a tiny
# /health endpoint on $PORT (default 8080) for Cloud Run-style health checks.
ExecStart=/var/www/sociochat/backend/venv/bin/python worker.py

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
