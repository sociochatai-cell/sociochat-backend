# right AFTER `db.session.commit()` that sets email_verified=True/status="active":
#
#     # Phase A: mirror verified T0000 user into Sociovia master. Failure-isolated.
#     try:
#         from master_identity_hook import mirror_user_to_master
#         mirror_user_to_master(user)
#     except Exception:
